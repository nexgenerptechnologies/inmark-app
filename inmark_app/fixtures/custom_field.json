  "insert_after": "item_group",
  "label": "Is Finished Good",
  "name": "Item-custom_is_finished_good"
 },
 {
  "depends_on": "eval:doc.custom_is_finished_good == 1",
  "doctype": "Custom Field",
  "dt": "Item",
  "fieldname": "custom_section_fg_packaging",
  "fieldtype": "Section Break",
  "insert_after": "custom_is_finished_good",
