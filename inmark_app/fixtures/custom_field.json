  "insert_after": "custom_packing_length",
  "label": "Packing Breadth (cm)",
  "name": "Item-custom_packing_breadth"
 },
 {
  "doctype": "Custom Field",
  "dt": "Item",
  "fieldname": "custom_packing_height",
  "fieldtype": "Float",
  "insert_after": "custom_packing_breadth",
  "label": "Packing Height (cm)",
  "name": "Item-custom_packing_height"
 },
 {
  "description": "Auto-calculated: (L \u00d7 B \u00d7 H) / 1,000,000",
