 },
 {
  "description": "Sum of all carton CBMs",
  "doctype": "Custom Field",
  "dt": "Item",
  "fieldname": "custom_total_carton_cbm",
  "fieldtype": "Float",
  "insert_after": "custom_section_fg_summary",
  "label": "Total Carton CBM",
  "name": "Item-custom_total_carton_cbm",
  "precision": "4",
  "read_only": 1
 },
 {
  "doctype": "Custom Field",
  "dt": "Item",
  "fieldname": "custom_col_weights",
  "fieldtype": "Column Break",
  "insert_after": "custom_total_carton_cbm",
  "name": "Item-custom_col_weights"
 },
 {
  "doctype": "Custom Field",
  "dt": "Item",
  "fieldname": "custom_net_weight_kg",
  "fieldtype": "Float",
  "insert_after": "custom_col_weights",
  "label": "Net Weight (Kg)",
  "name": "Item-custom_net_weight_kg"
 },
 {
  "doctype": "Custom Field",
  "dt": "Item",
  "fieldname": "custom_gross_weight_kg",
